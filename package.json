{
  "name": "agentic-documents",
  "version": "0.3.0",
  "description": "Write documents with people and agents in real time.",
  "keywords": [
    "documents",
    "editor",
    "rich-text",
    "tiptap",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "cloudflare"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "homepage": "https://github.com/pooriaarab/agentic-documents#readme",
  "bugs": {
    "url": "https://github.com/pooriaarab/agentic-documents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-documents.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "SECURITY.md",
    "SKILL.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-documents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./live-worker": {
      "types": "./dist/live-worker.d.ts",
      "import": "./dist/live-worker.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.4.0",
    "agentic-realtime": "^0.1.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.1",
    "micromark-extension-gfm": "^3.0.0",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-documents": "./dist/cli.js"
  }
}
