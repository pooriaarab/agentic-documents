{
  "name": "agentic-documents",
  "version": "0.12.2",
  "description": "Write documents with people and agents in real time.",
  "keywords": [
    "documents",
    "editor",
    "rich-text",
    "tiptap",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "cloudflare"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "homepage": "https://github.com/pooriaarab/agentic-documents#readme",
  "bugs": {
    "url": "https://github.com/pooriaarab/agentic-documents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-documents.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "SKILL.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-documents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/editor.css",
    "./app.css": "./dist/app.css",
    "./live-worker": {
      "types": "./dist/live-worker.d.ts",
      "import": "./dist/live-worker.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node ui/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test && playwright test",
    "e2e": "npm run build && playwright test",
    "deploy:demo": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --var AGENTIC_DOCS_REGION:unknown --var AGENTIC_DOCS_UNSAFE_REGION:1",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-collaboration": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/y-tiptap": "^3.0.11",
    "agentic-design": "^0.9.0",
    "agentic-formats": "^0.4.2",
    "agentic-identity": "^0.9.0",
    "agentic-realtime": "^0.4.4",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.1",
    "micromark-extension-gfm": "^3.0.0",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "overrides": {
    "agentic-formats": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "bin": {
    "agentic-documents": "./dist/cli.js"
  }
}
