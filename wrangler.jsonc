{
  // The Worker signs in with agentic-identity keys stored in the D1 database below. See "Sign-in" in the README.
  // For local development only, you can use a static token table: set AGENTIC_DOCS_UNSAFE_TOKENS=1 and the secret AGENTIC_DOCS_TOKENS.
  // Never set either in production.
  "name": "agentic-documents",
  "main": "src/live-worker.ts",
  // Create the bucket with `wrangler r2 bucket create agentic-documents-data --jurisdiction eu`.
  // Create the database with `wrangler d1 create agentic-documents --jurisdiction eu`, then put its id below.
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // The web UI. Run `npm run build` first: it writes dist/ui. The Worker serves the files in dist/ui first, and answers /api, /health, and any other path.
  "assets": { "directory": "./dist/ui" },
  // The live rooms. One Durable Object holds one document.
  "durable_objects": { "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-documents", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "agentic-documents-data", "jurisdiction": "eu" }]
}
